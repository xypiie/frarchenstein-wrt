+/* Dedicated hybrid init profile: never continue normal boot after a failure. */
+#ifndef FRARCHENSTEIN_RECOVERY_H
+#define FRARCHENSTEIN_RECOVERY_H
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <sys/wait.h>
+#include <linux/magic.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "watchdog.h"
+
+static inline __attribute__((noreturn)) void frarchenstein_recovery(const char *why)
+{
+    int console = open("/dev/console", O_RDWR);
+    if (console >= 0) {
+        dup2(console, 0); dup2(console, 1); dup2(console, 2);
+        if (console > 2) close(console);
+    }
+    fprintf(stderr, "frarchenstein: recovery required: %s\n", why);
+    for (;;) {
+        pid_t child = fork();
+        if (child == 0) {
+            execl("/bin/sh", "sh", "-i", (char *)NULL);
+            _exit(127);
+        }
+        if (child > 0) {
+            while (waitpid(child, NULL, WNOHANG) == 0) {
+                watchdog_ping();
+                sleep(1);
+            }
+        }
+        watchdog_ping();
+        sleep(1);
+        fprintf(stderr, "frarchenstein: leaving recovery does not resume normal boot; repair and reboot\n");
+    }
+}
+
+static inline void frarchenstein_check_fs(const char *path, long expected)
+{
+    struct statfs fs;
+    if (statfs(path, &fs) || fs.f_type != expected)
+        frarchenstein_recovery("prepared API filesystem is missing");
+}
+
+static inline void frarchenstein_preserve_mounts(void)
+{
+    if (access("/run/frarchenstein/prepared", R_OK))
+        frarchenstein_recovery("custom initramfs handoff marker is missing");
+    frarchenstein_check_fs("/proc", PROC_SUPER_MAGIC);
+    frarchenstein_check_fs("/sys", SYSFS_MAGIC);
+    frarchenstein_check_fs("/dev", TMPFS_MAGIC);
+    frarchenstein_check_fs("/tmp", TMPFS_MAGIC);
+    frarchenstein_check_fs("/run", TMPFS_MAGIC);
+}
+#endif
